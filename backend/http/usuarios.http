@baseUrl = http://localhost:3000

### Iniciar sesión para obtener el token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "prueba@transporte.com",
  "contrasena": "Prueba1234"
}

@token = {{login.response.body.token}}
@miId = {{login.response.body.usuario.id}}

### Listar usuarios (200)
GET {{baseUrl}}/usuarios
Authorization: Bearer {{token}}

### Listar usuarios sin token (401)
GET {{baseUrl}}/usuarios

### Obtener mi usuario (200)
GET {{baseUrl}}/usuarios/{{miId}}
Authorization: Bearer {{token}}

### Usuario inexistente (404)
GET {{baseUrl}}/usuarios/99999
Authorization: Bearer {{token}}

### Id inválido (400)
GET {{baseUrl}}/usuarios/abc
Authorization: Bearer {{token}}

### Modificar mi nombre (200)
PUT {{baseUrl}}/usuarios/{{miId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Usuario Modificado"
}

### Modificar otro usuario (403)
PUT {{baseUrl}}/usuarios/99999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Intento no permitido"
}

### Eliminar otro usuario (403)
DELETE {{baseUrl}}/usuarios/99999
Authorization: Bearer {{token}}
